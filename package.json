{
  "name": "obsidian-ollama-assistant",
  "version": "1.0.3",
  "description": "Obsidian plugin that connects local AI via Ollama for text editing, note discussion, and web search.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "author": "xlrve",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.8",
    "eslint": "^10.8.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "lottie-web": "^5.13.0"
  }
}
